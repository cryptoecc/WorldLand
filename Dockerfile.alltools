# --------------------------------------------
# ✅ Optional build-time metadata (labels for the final image)
# --------------------------------------------
	ARG COMMIT=""
	ARG VERSION=""
	ARG BUILDNUM=""
	
	# --------------------------------------------
	# ✅ Stage 1: Build the WorldLand binaries using a Go builder image
	# --------------------------------------------
	FROM golang:1.24-alpine AS builder
	
	# Install necessary build tools
	RUN apk add --no-cache gcc musl-dev linux-headers git
	
	# Copy Go module files and download dependencies
	COPY go.mod /worldland/
	COPY go.sum /worldland/
	RUN cd /worldland && go mod download
	
	# Copy the entire source code
	ADD . /worldland
	
	# Build the main WorldLand binary (partial build for caching)
	RUN cd /worldland && go run build/ci.go install -static ./cmd/worldland
	
	# Build all project binaries
	RUN cd /worldland && go run build/ci.go install -static
	
	# --------------------------------------------
	# ✅ Stage 2: Create a minimal runtime container
	# --------------------------------------------
	FROM alpine:latest
	
	# Install required runtime packages
	RUN apk add --no-cache ca-certificates
	
	# Copy compiled binaries from the builder stage
	COPY --from=builder /worldland/build/bin/* /usr/local/bin/
	
	# Expose commonly used ports
	EXPOSE 8545 8546 30303 30303/udp
	
	# --------------------------------------------
	# ✅ Add metadata labels to the final image
	# --------------------------------------------
	ARG COMMIT=""
	ARG VERSION=""
	ARG BUILDNUM=""
	
	LABEL commit="$COMMIT" version="$VERSION" buildnum="$BUILDNUM"
	